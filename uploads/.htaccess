# Uploaded files must never be executable as scripts, regardless of
# the extension a user manages to get past application-level checks.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|asp|aspx|jsp|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
